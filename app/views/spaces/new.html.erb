<%- model_class = Space -%>
<div class="page-header">
  <%= page_title(t('.title', default: [:'helpers.titles.new', 'New %{model}'], model: model_class.model_name.human.titleize.downcase)) %>
</div>
<div class="row">
  <div class="col-md-4 col-md-push-8">
    <%= render partial: 'spaces/partials/general_space_info' %>
  </div>
  <div class="col-md-8 col-md-pull-4">
    <%= render partial: 'form' %>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    let checkbox = document.getElementById("space_is_private")
    let container = document.getElementById("groups_container")

    const toggleGroups = () => {
      if (checkbox && checkbox.checked) {
        container.style.display = "block"
      } else {
        container.style.display = "none"
      }
    }

    toggleGroups()

    if (checkbox) {
      checkbox.addEventListener("change", toggleGroups)
    }
  })
</script>