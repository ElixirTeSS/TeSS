<% content_for :title, @group.title %>

<div class="wrapper collapsing-wrapper">
  <%# SIDEBAR %>
  <div id="sidebar" class="collapsing-sidebar">
    <h4 class="nav-heading"><%= t('group.show.group') %></h4>
    <div class="nav-block">
      <h5><%= @group.title %></h5>
    </div>

    <h4 class="nav-heading">
      <%= t('group.show.members') %>
      <span class="badge" style="background:#2a6ebb; margin-left: 4px;">
        <%= @group.group_memberships.count %>
      </span>
    </h4>
    <div class="nav-block">
      <% if @memberships.any? %>
        <% @memberships.each do |membership| %>
          <p style="margin-bottom: 0.5rem;">
            <% if membership.owner? %>
              <i class="glyphicon glyphicon-star color-accent" title="<%= t('group.show.owner') %>"></i>
            <% else %>
              <i class="glyphicon glyphicon-user text-secondary"></i>
            <% end %>
            &nbsp;<strong><%= membership.user.name %></strong>
            <% if membership.owner? %>
              <br><span class="text-muted" style="padding-left: 20px; font-size: 0.85em;"><%= t('group.show.owner') %></span>
            <% end %>
          </p>
        <% end %>
      <% else %>
        <span class="empty"><%= t('group.show.no_members') %></span>
      <% end %>
    </div>

    <h4 class="nav-heading"><%= t('group.show.stats.title') %></h4>
    <div class="nav-block">
      <p>
        <strong><%= t('group.show.stats.total') %></strong><br/>
        <%= @group.group_memberships.count %>
      </p>
      <p>
        <strong><%= t('group.show.stats.owners') %></strong><br/>
        <%= @group.group_memberships.select(&:owner?).count %>
      </p>
    </div>
  </div>

  <%# MAIN CONTENT %>
  <div id="content">
    <div class="content-actions">
      <div class="content-viewer-actions"></div>
      <div class="content-manager-actions">
        <% if policy(@group).update? %>
          <%= edit_button(@group) %>
        <% end %>
        <% if policy(@group).destroy? %>
          <%= delete_button(@group) %>
        <% end %>
      </div>
    </div>

    <%= link_to groups_path, class: 'btn btn-default' do %>
      <i class="glyphicon glyphicon-arrow-left"></i> <%= t('group.show.back_to_groups') %>
    <% end %>

    <%# Members table %>

    <% if @memberships.any? %>
      <table class="table table-hover" style="margin-top: 1rem;">
        <thead>
          <tr>
            <th><%= t('group.show.table.name') %></th>
            <% if @memberships.first.user.respond_to?(:email) %>
              <th><%= t('group.show.table.email') %></th>
            <% end %>
            <th><%= t('group.show.table.role') %></th>
          </tr>
        </thead>
        <tbody>
          <% @memberships.each do |membership| %>
            <tr class="<%= membership.owner? ? 'warning' : '' %>">
              <td>
                <%= link_to membership.user.name, membership.user %>
              </td>
              <% if membership.user.respond_to?(:email) %>
                <td class="text-muted"><%= membership.user.email %></td>
              <% end %>
              <td>
                <% if membership.owner? %>
                  <span class="label bg-accent">
                    <i class="glyphicon glyphicon-star"></i> <%= t('group.show.table.owner') %>
                  </span>
                <% else %>
                  <span class="label label-default"><%= t('group.show.table.member') %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="well text-center" style="margin-top: 1rem;">
        <i class="glyphicon glyphicon-user text-secondary" style="font-size: 2rem;"></i>
        <p class="text-muted" style="margin-top: 0.5rem;">
          <%= t('group.show.no_members') %>
          <%= link_to t('group.show.add_members'), edit_group_path(@group) %>.
        </p>
      </div>
    <% end %>

    <hr/>

    <%# Private spaces table %>
    <% spaces = @group.spaces.all %>

    <h4 style="margin-top:120px;margin-bottom:25px;"><%= t('group.show.spaces.title') %></h4>

    <% if spaces.any? %>
      <table class="table table-hover" style="margin-top: 1rem;">
        <thead>
          <tr>
            <th><%= t('group.show.spaces.space') %></th>
            <th><%= t('group.show.spaces.other_groups') %></th>
          </tr>
        </thead>
        <tbody>
          <% spaces.each do |space| %>
          <% groups = space.groups.all %>
            <tr>
              <td>
                <%= link_to space.title, space %>
              </td>
              <td>
                <% groups.each_with_index do |group, index| %>
                  <% if group != @group %>
                    <%= index != groups.length-1 ? group.title + ',' : group.title %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="well text-center" style="margin-top: 1rem;">
        <i class="glyphicon glyphicon-th-large text-secondary" style="font-size: 2rem;"></i>
        <p class="text-muted" style="margin-top: 0.5rem;">
          <%= t('group.show.spaces.no_access') %>
        </p>
      </div>
    <% end %>
  </div>
</div>
